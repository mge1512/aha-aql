# generated from spec: aha-aql.spec.md sha256:b5c2ed33da65d1486080b50fd0a29bd64fef4f69ec258e8971393437c2fd7268
FROM registry.suse.com/bci/golang:latest AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -mod=mod -trimpath -ldflags="-X main.serverVersion=0.23.0" -o mcp-server-aha-aql .

FROM scratch
LABEL pcd.spec.sha256="b5c2ed33da65d1486080b50fd0a29bd64fef4f69ec258e8971393437c2fd7268"
LABEL org.opencontainers.image.title="mcp-server-aha-aql" \
      org.opencontainers.image.version="0.23.0" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/mge1512/aha-aql"
# The trust store of the image: the certificate authorities of its build.
# The server checks the certificate of Aha!. An operator can give a trust
# store of their own with SSL_CERT_FILE.
COPY --from=builder /var/lib/ca-certificates/ca-bundle.pem /etc/ssl/ca-bundle.pem
COPY --from=builder /build/mcp-server-aha-aql /usr/bin/mcp-server-aha-aql
EXPOSE 8080
ENTRYPOINT ["/usr/bin/mcp-server-aha-aql", "http"]
