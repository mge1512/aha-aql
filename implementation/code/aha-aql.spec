# pcd-spec-sha256: b5064b9ba50274af776104231d9794d500d571b98535d7bff53fa730836f6f30
#
# spec file for package mcp-server-aha-aql
#
# Source1 is generated by: make vendor-tarball
#   (go mod vendor && tar -cJf mcp-server-aha-aql-0.20.1-vendor.tar.xz vendor/)

Name:           mcp-server-aha-aql
Version:        0.20.1
Release:        1%{?dist}
Summary:        MCP server for Aha! with the query language AQL
License:        MIT
URL:            https://github.com/mge1512/aha-aql
Source0:        %{name}-%{version}.tar.xz
Source1:        %{name}-%{version}-vendor.tar.xz
BuildRequires:  golang >= 1.25
BuildRequires:  pandoc
%if 0%{?suse_version}
BuildRequires:  systemd-rpm-macros
%{?systemd_ordering}
%else
BuildRequires:  systemd-rpm-macros
%{?systemd_requires}
%endif

%description
mcp-server-aha-aql is an MCP server for the Aha! product management
service. A language model reads and changes Aha! records through one query
language, AQL, and two tools: query reads, and execute changes one record.
The server runs on standard input and output (stdio), on HTTP (http), or as
a command that makes one tool call (query, execute).

%prep
%autosetup -a 1

%build
pandoc mcp-server-aha-aql.1.md -s -t man -o mcp-server-aha-aql.1
CGO_ENABLED=0 go build \
    -mod=vendor \
    -trimpath \
    -ldflags="-X main.serverVersion=%{version}" \
    -o %{name} \
    .

%check
CGO_ENABLED=0 go vet -mod=vendor ./...
CGO_ENABLED=0 go test -mod=vendor -count=1 -timeout 20m ./independent_tests/...

%install
install -D -m 0755 %{name} %{buildroot}%{_bindir}/%{name}
install -D -m 0644 mcp-server-aha-aql.1 %{buildroot}%{_mandir}/man1/mcp-server-aha-aql.1
install -D -m 0644 mcp-server-aha-aql.service %{buildroot}%{_unitdir}/mcp-server-aha-aql.service

%if 0%{?suse_version}
%pre
%service_add_pre mcp-server-aha-aql.service

%post
%service_add_post mcp-server-aha-aql.service

%preun
%service_del_preun mcp-server-aha-aql.service

%postun
%service_del_postun mcp-server-aha-aql.service
%else
%post
%systemd_post mcp-server-aha-aql.service

%preun
%systemd_preun mcp-server-aha-aql.service

%postun
%systemd_postun_with_restart mcp-server-aha-aql.service
%endif

%files
%license LICENSE
%doc README.md
%{_bindir}/%{name}
%{_mandir}/man1/mcp-server-aha-aql.1*
%{_unitdir}/mcp-server-aha-aql.service

%changelog
